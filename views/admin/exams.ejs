<div class="page-header">
  <h1>Exams</h1>
  <a class="btn btn-primary" href="/admin/exams/new">+ Create Exam</a>
</div>

<% if (exams.length === 0) { %>
  <p class="muted">No exams created yet.</p>
<% } else { %>
  <table class="data-table">
    <thead><tr><th>Title</th><th>Subject</th><th>Duration</th><th>Questions</th><th>Pass Mark</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% exams.forEach(e => { %>
        <tr>
          <td><%= e.title %></td>
          <td><%= e.subject_name %></td>
          <td><%= e.duration_minutes %> min</td>
          <td><%= e.num_questions %> (pool: <%= e.available_questions %>)</td>
          <td><%= e.pass_mark_percent %>%</td>
          <td><span class="badge <%= e.is_active ? 'badge-success' : 'badge-muted' %>"><%= e.is_active ? 'Active' : 'Inactive' %></span></td>
          <td class="actions">
            <form method="POST" action="/admin/exams/<%= e.id %>/toggle" class="inline-form">
              <button type="submit" class="link-button"><%= e.is_active ? 'Deactivate' : 'Activate' %></button>
            </form>
            <form method="POST" action="/admin/exams/<%= e.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this exam? Attempt history will also be removed.');">
              <button type="submit" class="link-button danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
