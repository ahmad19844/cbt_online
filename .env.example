# PostgreSQL connection string
# Render provides this automatically as "Internal Database URL" when you
# link a Postgres database to your web service as an env var group,
# or you can paste the External Database URL for local development.
DATABASE_URL=postgres://user:password@localhost:5432/cbt_exam

# Set to "true" only when connecting to a DB that requires SSL (Render does)
DB_SSL=true

# Session secret - generate a long random string for production
SESSION_SECRET=change_this_to_a_long_random_string

# Port (Render sets this automatically, default fallback for local dev)
PORT=3000

# Default admin account created by "npm run seed"
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_EMAIL=amy33375@gmail.com
DEFAULT_ADMIN_PASSWORD=Wasko@1984

# SMTP settings for the "forgot password" email flow.
# Optional: if left unset, reset links are shown directly on-screen instead of
# emailed (handy for local dev / first deploy). Works with any SMTP provider
# (Gmail app password, SendGrid, Mailgun, Resend, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
